# elev8rix Private Demo Gateway — Environment Configuration
# Add these in Vercel Project Settings -> Environment Variables

# Master Admin Password for /admin console
ADMIN_PASSWORD=shashwat2908

# Cryptographic Session Secret (replace with random 32+ chars)
SESSION_SECRET=super-secret-demo-gateway-signing-salt-2026-production

# Upstash Redis REST credentials (1-click via Vercel Marketplace -> Upstash Redis)
# If omitted during local dev, automatically falls back to local data/keys.json
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
